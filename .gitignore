# Local automation credentials and machine-specific configuration
.env
.env.*
!.env.example
/CMakeUserPresets.json
.DS_Store

# Build outputs
/build/
/build-*/
/out/
/dist/
__pycache__/

# Private media and evidence belong here or outside the checkout.
# Audited public test fixtures must use an explicit tracked location.
/local/
/roms/
/bios/
/private-corpus/
/private-results/

# Regenerable OpenGSD research retrieval cache
/.planning/research/.cache/

# Local OpenGSD dispatch, process lock and derived state projection
/.gsd/dispatch-isolation-sentinel.json
/.planning/milestone.lock
/.planning/state.json
/.planning/workstreams/*/state.json
/.planning/workstreams/*/milestone.lock
/.planning/workstreams/*/.verification-ledger.json
/.planning/workstreams/*/phases/*/.plan-start-epoch
/.planning/workstreams/*/phases/*/.plan-start-time

# Local workstream config (untracked by design; check_security_register.py
# rejects a value weaker than the root .planning/config.json)
/.planning/workstreams/*/config.json

# Executor scratch (RED-test evidence and similar transient captures)
/.planning/tmp/
