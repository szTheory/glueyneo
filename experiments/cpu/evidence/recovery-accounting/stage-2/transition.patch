diff --git a/m68kcpu.h b/m68kcpu.h
index bb882d4..d5a6cff 100644
--- a/m68kcpu.h
+++ b/m68kcpu.h
@@ -759,9 +759,9 @@ typedef uint32 uint64;
 #define EA_PCIX_32()   EA_PCIX_8()
 
 
-#define OPER_I_8()     m68ki_read_imm_8(ctx)
-#define OPER_I_16()    m68ki_read_imm_16(ctx)
-#define OPER_I_32()    m68ki_read_imm_32(ctx)
+#define OPER_I_8(ctx)     m68ki_read_imm_8(ctx)
+#define OPER_I_16(ctx)    m68ki_read_imm_16(ctx)
+#define OPER_I_32(ctx)    m68ki_read_imm_32(ctx)
 
 
 
@@ -2247,11 +2247,11 @@ static uint32 lshift32_safe(uint32 val, unsigned shift) {
 	return shift < 32 ? (val << shift) : 0;
 }
 
-static inline unsigned m68ki_bitfield_patch_offset(m68ki_context *ctx, int32 offset) {
+static inline unsigned m68ki_bitfield_patch_offset(m68ki_context *ctx, sint32 offset) {
 	return ((uint32)offset) % 8;
 }
 
-static inline uint32 m68ki_bitfield_patch_ea(m68ki_context *ctx, uint32 ea, int32 offset) {
+static inline uint32 m68ki_bitfield_patch_ea(m68ki_context *ctx, uint32 ea, sint32 offset) {
 	return ea + (offset >= 0 ? offset / 8 : -((7 - offset) / 8));
 }
 
